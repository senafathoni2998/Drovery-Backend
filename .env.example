# ==================== APP ====================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ==================== DATABASE ====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drovery?schema=public
# Max connections in this instance's pg pool. With N replicas, keep N×max under
# Postgres max_connections — or point DATABASE_URL at PgBouncer (see docker-compose).
# DATABASE_POOL_MAX=10
# Optional READ REPLICA. When set, lag-tolerant heavy reads (lists, tracking polls,
# stats, admin reports) route here; ALL writes + read-after-write/CAS reads stay on
# the primary. Unset → reads use the primary (single-DB dev/test is unchanged). A
# replica blip falls back to the primary (no 5xx).
# DATABASE_REPLICA_URL=postgresql://postgres:postgres@replica-host:5432/drovery?schema=public
# Reader pool size (defaults to DATABASE_POOL_MAX). Tune down (e.g. 5) for the API,
# and front the replica with its own PgBouncer at scale.
# DATABASE_REPLICA_POOL_MAX=10

# ==================== JWT ====================
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ==================== REDIS (required — queue + cache + rate limiting) ====================
REDIS_HOST=localhost
REDIS_PORT=6379
# Managed Redis (ElastiCache/Upstash/etc.) usually needs auth + TLS:
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=true
# Pub/sub delivery mode for tracking + support-chat fan-out (telemetry hot path):
#   'standard' (default) = PUBLISH/SUBSCRIBE broadcast (today's behavior).
#   'sharded'  = SPUBLISH/SSUBSCRIBE (Redis 7.0+) — routes by hash slot so the
#                firehose scales across a Redis Cluster. MUST be identical on the
#                worker (publisher) and api/realtime (subscriber) tiers.
# REDIS_PUBSUB_MODE=standard

# ==================== WORKER ====================
# Role: unset/'all' = API also processes jobs (single process); 'api' = enqueue only
# PROCESS_ROLE=all
# Parallel jobs per worker
# SIM_WORKER_CONCURRENCY=10

# ==================== TRANSACTIONAL OUTBOX (1M+ §2, Phase-3 DB-write-shard unblock) ====================
# Producer flag: route the referral reward through the outbox (enqueued atomically with the
# delivery, applied async by the worker dispatcher) instead of the inline in-tx grant.
# Default off = today's synchronous grant, byte-identical. Promo/wallet-debit stay inline (later stages).
# DELIVERY_OUTBOX_REFERRAL=true
# Worker dispatcher kill-switch (default on). Interval / batch / retry knobs:
# OUTBOX_DISPATCH_ENABLED=false
# OUTBOX_DISPATCH_INTERVAL_MS=5000
# OUTBOX_BATCH=100
# OUTBOX_MAX_ATTEMPTS=5
# OUTBOX_CLAIM_LEASE_MS=60000   # a PROCESSING claim older than this is reaped back to PENDING

# ==================== DEBIT-FIRST SAGA (1M+ §2 Phase-3 — charge-gating debit/promo) ====================
# When ON, create() runs the authoritative promo-redeem + wallet-debit in their OWN single-shard
# transactions BEFORE the delivery tx (so no single $transaction co-commits user-rooted balance state
# with the delivery row — the unblock for shardCount>1). Default off = today's co-committing tx, byte-identical.
# DELIVERY_DEBIT_FIRST=true
# The orphan-reservation reaper (worker tier) is the out-of-process safety net for the saga's
# process-crash window; it auto-activates ONLY when DELIVERY_DEBIT_FIRST=true (inert otherwise).
# ORPHAN_REAPER_ENABLED=false      # kill switch (default on when the saga is on)
# ORPHAN_REAPER_INTERVAL_MS=60000
# ORPHAN_GRACE_MS=600000           # a reservation younger than this is never compensated (money knob)
# ORPHAN_LOOKBACK_MS=86400000      # sliding-window floor that bounds the scan cost
# ORPHAN_BATCH=500

# ==================== CORS ====================
# Comma-separated browser allowlist (enables credentials). Unset → wildcard, no credentials.
# CORS_ORIGINS=https://app.drovery.com,https://admin.drovery.com

# ==================== STRIPE ====================
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxx  (also set EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY in mobile)
# Demo/portfolio deploys with NO real Stripe: set ALLOW_MOCK_PAYMENTS=true to boot in production
# without the keys above. Stripe runs keyless (payments confirm at creation) and the public
# webhook fails CLOSED (rejects unsigned events) so there's no fail-open. Leave UNSET for real payments.
# ALLOW_MOCK_PAYMENTS=true

# ==================== GEOCODING ====================
GEOCODING_PROVIDER=nominatim
# GOOGLE_MAPS_API_KEY=xxxx

# ==================== WEATHER (drone serviceability) ====================
# Unset → deterministic mock weather. Set to use real OpenWeather (fail-open).
# OPENWEATHER_API_KEY=xxxx

# ==================== SERVICE AREA ====================
# By default deliveries are geofenced to the hub regions in serviceability.constants.ts
# (Greater Jakarta + Greater Bandung) — a delivery whose pickup OR dropoff is outside them is
# rejected (OUT_OF_AREA). Set this to make EVERYWHERE serviceable so any user anywhere can place
# a delivery (no-fly zones + weather checks still apply). Default off = the geofenced demo.
# SERVICE_AREA_GLOBAL=true

# Hard ceiling on a single delivery's point-to-point distance, in km. Independent of
# the geofence: SERVICE_AREA_GLOBAL makes the area check vacuous, and even with the
# geofence ON the two hubs are ~120 km apart, so both endpoints can be "in area" on a
# route no battery-electric multirotor can fly. Default 50. A non-positive or
# unparseable value falls back to the default rather than disabling the bound.
# MAX_ROUTE_KM=50

# ==================== RESTRICTED AIRSPACE ====================
# How long (ms) an instance may serve its in-memory list of in-force no-fly zones before
# re-reading `airspace_zones`. Default 30000. Serviceability runs on every quote, and the
# zone list used to be a module constant, so an uncached read adds a DB round trip to a
# hot path.
#
# What this bounds, stated honestly — it is a STALENESS CAP, not a propagation guarantee:
#   * An admin write (POST/PATCH/DELETE /admin/airspace) invalidates the cache immediately,
#     but only on the instance that served the write. Every OTHER replica keeps serving its
#     own copy for up to this long.
#   * A zone that comes into force by the CLOCK — a future `activeFrom` crossing now — has
#     no write to hang an invalidation on, so it is covered by this TTL on every instance,
#     including the one that created it. Pre-staging a TFR is exactly this case.
# So the worst case for a new restriction taking effect fleet-wide is one TTL. 30s is chosen
# so that worst case is small and STATED, not because the load requires it.
#
# 0 is honored and means no caching — read on every call. A negative or unparseable value
# falls back to the default rather than silently disabling the cache.
# AIRSPACE_CACHE_TTL_MS=30000

# ==================== DISPATCH ====================
# Whether this deployment flies REAL registered aircraft.
#
# Unset/false (default): every delivery is SIMULATED — no fleet required, no aircraft
# claimed. This is what dev, CI and every demo deployment run.
#
# true: DispatchService selects an airframe from the `drones` table that can actually
# complete the mission (payload, state of charge, out-and-back range) and claims it
# atomically. A delivery it cannot fly is REJECTED, never quietly downgraded to a
# simulation — so turning this on with an empty or saturated fleet fails bookings by
# design. Register aircraft in the admin fleet console first.
#
# Scheduled pickups still run SIMULATED under this flag: an airframe is not held out of
# service for weeks, and kickoff-time dispatch is Phase 12 work.
# LIVE_DISPATCH=true

# ==================== LIVE DRONE TELEMETRY INGESTION ====================
# Shared key a drone-gateway sends as `x-ingest-key` to POST /ingest/telemetry.
# FAIL-CLOSED: unset → the ingest endpoint is disabled (every request denied).
# INGEST_API_KEY=change-me-to-a-random-ingest-key
# Optional second factor: when set, also require an `x-ingest-timestamp` + an
# `x-ingest-signature` = HMAC-SHA256 over `${timestamp}.${method}.${path}.${rawBody}`
# (anti-replay 5-min window + binds the request line, so a captured signature can't
# be retargeted to another route/drone/command). Unset → key-only auth.
# INGEST_HMAC_SECRET=change-me-to-a-random-hmac-secret
# Optional MQTT push transport. UNSET → MqttService is inert (MOCK) and the HTTP /ingest
# endpoints are the active drone↔backend transport. SET → telemetry + command-ack are also
# consumed over the broker, and issued commands are pushed to the drone (HTTP stays the
# fallback). mqtt:// or mqtts:// (TLS). docker-compose runs a local mosquitto for this.
# MQTT_URL=mqtts://broker.example.com:8883
# MQTT_USERNAME=         # broker creds (prod: per-device users + topic ACLs)
# MQTT_PASSWORD=
# MQTT_SHARED=true       # MQTT5 shared subs → 1 api replica per frame; false for v3.1.1 brokers
# MQTT_SHARE_GROUP=drovery-ingest
# MQTT_OFFLINE_QUEUE_MAX=1000   # cap outbound publishes buffered during a broker outage
# MQTT_RECONNECT_MS=5000

# ==================== STUCK-DELIVERY WATCHDOG (self-healing reaper) ====================
# Worker-tier repeatable scan that reaps LIVE in-flight deliveries whose telemetry
# has gone silent (lost-comms drone, or a return flight that died) → DELIVERY_FAILED
# + customer refund, so a stranded delivery never sits in-flight forever. SIMULATED
# deliveries are out of scope (the sim drives them). All four knobs have safe
# defaults; read at worker boot, so changes need a worker restart/redeploy.
# WATCHDOG_ENABLED=true            # kill-switch (default on); false → reaper paused + scheduler torn down on next boot
# WATCHDOG_SCAN_INTERVAL_MS=60000  # how often the reaper scans
# WATCHDOG_SILENCE_MS=600000       # THE safety knob: telemetry-silence window (10m ≫ ~5s position cadence) before a LIVE in-flight delivery is reaped. Widen during a degraded-telemetry incident.
# WATCHDOG_MIN_AGE_MS=600000       # never reap a delivery younger than this (defaults to WATCHDOG_SILENCE_MS) — guards a brand-new flight with no tracking row yet

# ==================== PARTITION MAINTENANCE (time-range partitioned tables) ====================
# Worker-tier repeatable sweep that keeps the RANGE-partitioned tables provisioned:
# drains the DEFAULT partition, creates the forward window of monthly children, and
# (opt-in) drops children past the retention window. See prisma/PARTITIONING.md for the
# current table list and their partition keys.
# PARTITION_MAINTENANCE_ENABLED=true   # kill-switch (default on); false → paused + scheduler torn down on next boot
# PARTITION_SCAN_INTERVAL_MS=21600000  # sweep cadence (default 6h — partitions move by the month)
# PARTITION_MONTHS_AHEAD=3             # months of FUTURE child partitions kept ready (~90-day runway)
# PARTITION_RETAIN_MONTHS=0            # drop children older than N months; 0 (default) = retention disabled (keep all)
#
# PARTITION_RETAIN_MONTHS IS A GLOBAL DEFAULT, NOT THE LAST WORD. Each entry in
# PARTITIONED_TABLES (src/partition-maintenance/partition.constants.ts) may carry its own
# `retainMonths`, and a per-table value wins — INCLUDING an explicit 0. `admin_audit_logs`
# pins 0 for exactly that reason: the one table whose write rate would ever motivate
# turning retention on is `flight_frames` (one row per telemetry tick), and without the
# override, tuning telemetry volume would silently start dropping operator audit history
# with it. Whoever adds a table here decides its retention deliberately; leaving
# `retainMonths` off means "follow the global".

# ==================== MAIL / STORAGE (unset → dev fallbacks) ====================
# MAIL_PROVIDER=         # unset: emails are logged. set + integrate SendGrid/SES
# MAIL_FROM=no-reply@drovery.com
# STORAGE_PROVIDER=      # unset: proof photos stored inline as data URLs / placeholder

# ==================== PUSH NOTIFICATIONS ====================
EXPO_ACCESS_TOKEN=xxxx

# ==================== API DOCS (Swagger / OpenAPI) ====================
# Interactive docs at /api/v1/docs + machine-readable spec at /api/v1/docs-json
# (enumerates every route incl. /ingest/* and /admin/*; no secret VALUES). ON by
# default — this backend is a portfolio showcase, so the docs are intentionally
# published. Set to the exact string `false` to keep the surface unpublished in a
# locked-down deployment.
# SWAGGER_ENABLED=false

# ==================== METRICS (Prometheus) ====================
# METRICS_ENABLED=false   # kill switch (default: enabled)
# METRICS_PORT=9091       # worker's standalone /metrics HTTP server port

# ==================== TRACING (OpenTelemetry, distributed) ====================
# OFF by default (zero overhead). Enabled when TRACING_ENABLED is true OR an OTLP
# endpoint is set — AND SENTRY_DSN is UNSET (Sentry owns OTel when a DSN is present;
# pick one owner). A bad endpoint/instrumentation degrades to untraced, never crashes.
# TRACING_ENABLED=true
# Base OTLP/HTTP collector endpoint (Tempo/Jaeger/otelcol). Set the BASE URL — the
# exporter appends /v1/traces itself. Unset + TRACING_ENABLED → console exporter.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER=console   # force the console span exporter (local verification)
# Fraction of root traces sampled (0..1). Default: 0.05 in production, 1 in dev.
# OTEL_TRACES_SAMPLER_ARG=0.05

# ==================== LOAD TESTING (non-prod only) ====================
# Bypass rate limiting so a single-IP load test measures real throughput, not
# the limiter. Refused at boot when NODE_ENV=production.
# LOADTEST_BYPASS_THROTTLE=true

# ==================== ERROR TRACKING (unset → no-op) ====================
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# SENTRY_RELEASE=drovery-backend@0.0.1
# SENTRY_TRACES_SAMPLE_RATE=0   # 0..1, fraction of transactions traced
